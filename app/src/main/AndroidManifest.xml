<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:name=".OLauncherApplication"
        android:allowBackup="true"
        android:allowNativeHeapPointerTagging="false"
        android:label="O Launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- Mojo AWT error/storage screens are part of the pinned Java runtime library. -->
        <activity
            android:name="git.artdeell.mojo.MissingStorageActivity"
            android:exported="false"
            android:process=":gui_installer" />
        <activity
            android:name="git.artdeell.mojo.FatalErrorActivity"
            android:exported="false"
            android:process=":gui_installer"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog" />
        <activity
            android:name="git.artdeell.mojo.ShowErrorActivity"
            android:exported="false"
            android:process=":gui_installer"
            android:theme="@style/Theme.AppCompat.DayNight.Dialog" />
        <activity
            android:name=".OEngineMojoAwtActivity"
            android:process=":gui_installer"
            android:exported="false"
            android:screenOrientation="landscape"
            android:configChanges="keyboardHidden|orientation|screenSize|smallestScreenSize|screenLayout|keyboard|navigation|uiMode"
            android:theme="@style/MojoLauncher.AppTheme" />
        <service
            android:name=".OEngineGameProcessService"
            android:exported="false"
            android:process=":game" />
        <activity
            android:name=".MainActivity"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
